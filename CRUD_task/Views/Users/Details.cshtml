@model User
@section MainHeading{
    User Details
}
<div class="d-flex justify-content-between align-items-center">
    <a href="/Users/Index" class="btn btn-secondary">Back</a>
</div>
<p>
    <ul>
        <li>ID: @Model.Id</li>
        <li>Name: @Model.Name</li>
        <li>Age: @Model.Age</li>
        <li>Score: @Model.City</li>
    </ul>
</p>